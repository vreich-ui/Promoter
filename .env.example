# HTTP server port (Cloud Run injects PORT; defaults to 8080 locally)
PORT=8080

# Postgres connection string (docker-compose default shown below)
DATABASE_URL=postgres://promoter:promoter@localhost:5432/promoter

# Shared secret required on the MCP surface via the X-Promoter-Key header.
# Requests to /mcp without a matching key are rejected with 401.
PROMOTER_MCP_KEY=dev-secret-change-me

# Provider API keys for the agent adapter seam (all optional at boot;
# a provider only needs its key when runAgentStep is actually called for it).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
